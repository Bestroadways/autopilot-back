<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <httpRedirect enabled="false" destination="" exactDestination="false" />
        <rewrite>
            <rules>
                <rule name="ReverseProxyToNode">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:89/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
